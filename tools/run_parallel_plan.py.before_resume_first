#!/usr/bin/env python3

from __future__ import annotations

import argparse
import csv
import math
import os
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path


ROOT = Path.home() / "ConserveFM"

PLAN = ROOT / "manifests/experiments_v1/planned_runs.csv"
RUN_ROOT = ROOT / "runs"

TRAIN_ENTRY = ROOT / "tools/train_conservefm.py"
EVAL_ENTRY = ROOT / "tools/eval_conservefm.py"

RESEARCH = ROOT / "manifests/research_v1"
PRITHVI_RESEARCH = ROOT / "manifests/research_prithvi_transfer_v1"
ERA5 = ROOT / "data/ERA5_WeatherBench2_1979_2022"
FORECAST_ROOT = ROOT / "forecasts"
STATS = RESEARCH / "era5_channel_stats.npz"


MANAGED = [
    "status",
    "result_path",
    "started_at",
    "finished_at",
    "exit_code",
    "attempt",
    "last_error",
]



def research_for_backbone(backbone):
    """Return the research manifest directory for this backbone."""
    if str(backbone).strip().lower() == "prithvi_wxc":
        return PRITHVI_RESEARCH
    return RESEARCH

def now():
    return datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )


def parse_args():
    p = argparse.ArgumentParser()

    p.add_argument("--plan", type=Path, default=PLAN)
    p.add_argument("--run-root", type=Path, default=RUN_ROOT)

    p.add_argument("--python", required=True)
    p.add_argument("--data-site", required=True)

    p.add_argument("--gpu", default="0")

    p.add_argument(
        "--max-parallel",
        type=int,
        default=4,
    )

    p.add_argument(
        "--reserve-per-job-gib",
        type=float,
        default=7.0,
    )

    p.add_argument(
        "--headroom-gib",
        type=float,
        default=4.0,
    )

    p.add_argument(
        "--poll-seconds",
        type=int,
        default=10,
    )

    p.add_argument(
        "--launch-gap",
        type=int,
        default=10,
    )

    # Adaptive GPU admission control.
    # In this mode jobs are admitted one at a time according to
    # actual whole-device VRAM/utilization, including unrelated
    # processes such as Qwen.
    p.add_argument(
        "--adaptive-gpu",
        action="store_true",
    )

    p.add_argument(
        "--target-vram-gib",
        type=float,
        default=36.0,
    )

    p.add_argument(
        "--hard-vram-gib",
        type=float,
        default=38.0,
    )

    p.add_argument(
        "--target-util",
        type=float,
        default=93.0,
    )

    p.add_argument(
        "--hard-max-parallel",
        type=int,
        default=12,
    )

    p.add_argument(
        "--adaptive-warmup-seconds",
        type=float,
        default=30.0,
    )

    p.add_argument(
        "--adaptive-min-job-gib",
        type=float,
        default=1.5,
    )

    p.add_argument(
        "--adaptive-ewma-alpha",
        type=float,
        default=0.35,
    )

    p.add_argument(
        "--target-host-available-gib",
        type=float,
        default=12.0,
    )

    p.add_argument(
        "--critical-host-available-gib",
        type=float,
        default=6.0,
    )

    p.add_argument(
        "--reserve-host-per-job-gib",
        type=float,
        default=2.0,
    )

    p.add_argument(
        "--critical-free-gib",
        type=float,
        default=0.7,
    )

    p.add_argument(
        "--critical-used-gib",
        type=float,
        default=39.3,
    )

    p.add_argument(
        "--critical-samples",
        type=int,
        default=3,
    )

    p.add_argument(
        "--shed-cooldown-seconds",
        type=float,
        default=30.0,
    )

    p.add_argument(
        "--retry-failed",
        action="store_true",
    )

    p.add_argument(
        "--smoke",
        action="store_true",
    )

    p.add_argument(
        "--limit",
        type=int,
        default=0,
    )

    return p.parse_args()


def load_plan(path):
    with path.open(
        newline="",
        encoding="utf-8",
    ) as f:
        reader = csv.DictReader(f)
        rows = list(reader)
        fields = list(reader.fieldnames or [])

    for field in MANAGED:
        if field not in fields:
            fields.append(field)

    for row in rows:
        for field in MANAGED:
            row.setdefault(field, "")

        if not row["status"]:
            row["status"] = "planned"

        if not row["attempt"]:
            row["attempt"] = "0"

    return rows, fields


def save_plan(path, rows, fields):
    tmp = path.with_suffix(
        path.suffix + ".tmp"
    )

    with tmp.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as f:
        w = csv.DictWriter(
            f,
            fieldnames=fields,
            extrasaction="ignore",
        )

        w.writeheader()
        w.writerows(rows)

        f.flush()
        os.fsync(f.fileno())

    os.replace(tmp, path)


def host_memory_status():
    """Return Linux host RAM/swap state in GiB."""
    values = {}

    with open("/proc/meminfo", "r", encoding="utf-8") as f:
        for line in f:
            key, value = line.split(":", 1)
            parts = value.strip().split()

            if not parts:
                continue

            # /proc/meminfo values are normally kB.
            values[key] = float(parts[0]) / 1024 / 1024

    return {
        "total": values.get("MemTotal", 0.0),
        "available": values.get("MemAvailable", 0.0),
        "free": values.get("MemFree", 0.0),
        "swap_total": values.get("SwapTotal", 0.0),
        "swap_free": values.get("SwapFree", 0.0),
    }


def gpu_status(gpu):
    out = subprocess.check_output(
        [
            "nvidia-smi",
            "-i",
            str(gpu),
            "--query-gpu="
            "memory.total,memory.used,"
            "memory.free,utilization.gpu",
            "--format=csv,noheader,nounits",
        ],
        text=True,
    ).strip()

    total, used, free, util = [
        float(x.strip())
        for x in out.split(",")
    ]

    return {
        "total": total,
        "used": used,
        "free": free,
        "util": util,
    }


def pipe_values(value):
    return ",".join(
        x.strip()
        for x in (value or "").split("|")
        if x.strip()
    )


def ready(row, by_id):
    if row["status"] not in {
        "planned",
        "pending",
        "interrupted",
    }:
        return False

    dep = (
        row.get("depends_on", "")
        or ""
    ).strip()

    if not dep:
        return True

    parent = by_id.get(dep)

    if parent is None:
        return False

    if parent["status"] != "completed":
        return False

    result = (
        parent.get("result_path", "")
        or ""
    )

    if not result:
        return False

    checkpoint = (
        Path(result)
        / "checkpoint_best.pt"
    )

    return checkpoint.exists()


def build_train(row, args, out):
    cmd = [
        args.python,
        "-u",
        str(TRAIN_ENTRY),

        "--run-id",
        row["run_id"],

        "--backbone",
        row["backbone"],

        "--family",
        row["family"],

        "--method",
        row["method"],

        "--seed",
        str(row["seed"]),

        "--research-manifest",
        str(research_for_backbone(row["backbone"])),

        "--era5-zarr",
        str(ERA5),

        "--forecast-root",
        str(FORECAST_ROOT),

        "--stats-path",
        str(STATS),

        "--output-dir",
        str(out),
    ]

    if args.smoke:
        cmd += [
            "--smoke",
            "--max-train-examples", "2",
            "--max-val-examples", "1",
            "--stats-samples", "1",
            "--width", "8",
            "--depth", "1",
        ]

    return cmd


def build_eval(row, args, out, by_id):
    cmd = [
        args.python,
        "-u",
        str(EVAL_ENTRY),

        "--run-id",
        row["run_id"],

        "--backbone",
        row["backbone"],

        "--family",
        row["family"],

        "--method",
        row["method"],

        "--seed",
        str(row["seed"]),

        "--research-manifest",
        str(research_for_backbone(row["backbone"])),

        "--era5-zarr",
        str(ERA5),

        "--forecast-root",
        str(FORECAST_ROOT),

        "--stats-path",
        str(STATS),

        "--output-dir",
        str(out),

        "--lead-hours",
        pipe_values(
            row.get("lead_hours", "")
        ),

        "--stress-types",
        pipe_values(
            row.get("stress_types", "")
        ),

        "--severities",
        pipe_values(
            row.get("severity", "")
        ),
    ]

    if (
        row.get("eval_clean", "")
        .lower() == "true"
    ):
        cmd.append("--eval-clean")

    if (
        row.get("eval_stress", "")
        .lower() == "true"
    ):
        cmd.append("--eval-stress")

    if (
        row.get("eval_ghcn", "")
        .lower() == "true"
    ):
        cmd.append("--eval-ghcn")

    dep = (
        row.get("depends_on", "")
        or ""
    ).strip()

    if dep:
        cmd += [
            "--checkpoint-dir",
            by_id[dep]["result_path"],
        ]

    if args.smoke:
        cmd += [
            "--smoke",
            "--max-clean-examples", "2",
            "--stress-examples", "1",
        ]

    return cmd


def stream(run_id, process, path):
    assert process.stdout is not None

    with path.open(
        "a",
        encoding="utf-8",
    ) as log:

        for line in process.stdout:
            log.write(line)
            log.flush()

            print(
                f"[{run_id}] {line}",
                end="",
                flush=True,
            )


def stop_process(process):
    if process.poll() is not None:
        return

    try:
        os.killpg(
            process.pid,
            signal.SIGTERM,
        )
    except ProcessLookupError:
        return

    try:
        process.wait(timeout=30)
        return

    except subprocess.TimeoutExpired:
        pass

    try:
        os.killpg(
            process.pid,
            signal.SIGKILL,
        )
    except ProcessLookupError:
        pass


def main():
    args = parse_args()

    args.plan = args.plan.expanduser().resolve()
    args.run_root = (
        args.run_root.expanduser().resolve()
    )

    args.run_root.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not STATS.exists():
        raise FileNotFoundError(
            f"Missing stats: {STATS}"
        )

    rows, fields = load_plan(
        args.plan
    )

    #
    # Recover stale processes.
    #
    for row in rows:
        if row["status"] == "running":
            row["status"] = "interrupted"
            row["last_error"] = (
                "Recovered stale running state"
            )

        if (
            row["status"] == "failed"
            and args.retry_failed
        ):
            row["status"] = "planned"

    save_plan(
        args.plan,
        rows,
        fields,
    )

    by_id = {
        r["run_id"]: r
        for r in rows
    }

    #
    # Full mode must have actual forecasts.
    #
    if not args.smoke:
        required = {
            r["backbone"]
            for r in rows
        }

        missing = []

        for backbone in sorted(required):
            path = (
                FORECAST_ROOT
                / f"{backbone}.zarr"
            )

            if not path.exists():
                missing.append(path)

        if missing:
            print(
                "FULL RUN BLOCKED."
            )
            print(
                "Missing forecast stores:"
            )

            for p in missing:
                print(" ", p)

            return 2

    total_planned = len(rows)

    if args.limit > 0:
        allowed_ids = {
            r["run_id"]
            for r in rows[
                :args.limit
            ]
        }
    else:
        allowed_ids = {
            r["run_id"]
            for r in rows
        }

    running = {}

    done_session = 0
    failed_session = 0

    last_launch = 0.0

    # Adaptive-GPU state. The memory estimate learns from the
    # observed whole-device memory delta after each launch.
    adaptive_util_ema = None
    adaptive_job_mem_ewma = None
    adaptive_probe = None
    adaptive_reason = "initializing"
    critical_count = 0
    shed_cooldown_until = 0.0

    print("=" * 78)
    print(
        "ConserveFM unified parallel scheduler"
    )
    print("=" * 78)
    print(
        "plan rows       :",
        total_planned,
    )
    print(
        "train rows      :",
        sum(
            r["job_type"] == "train"
            for r in rows
        ),
    )
    print(
        "eval rows       :",
        sum(
            r["job_type"] == "eval"
            for r in rows
        ),
    )
    print(
        "max parallel    :",
        args.max_parallel,
    )
    print(
        "GPU             :",
        args.gpu,
    )
    print(
        "smoke           :",
        args.smoke,
    )
    print("=" * 78)

    try:
        while True:
            #
            # Collect finished jobs.
            #
            for run_id in list(
                running
            ):
                info = running[
                    run_id
                ]

                code = (
                    info["process"]
                    .poll()
                )

                if code is None:
                    continue

                info["thread"].join(
                    timeout=5
                )

                row = by_id[run_id]

                row["finished_at"] = now()
                row["exit_code"] = str(code)
                row["result_path"] = str(
                    info["out"]
                )

                result_json = (
                    info["out"]
                    / "result.json"
                )

                if (
                    code == 0
                    and result_json.exists()
                ):
                    row["status"] = (
                        "completed"
                    )
                    row["last_error"] = ""
                    done_session += 1

                    print(
                        f"\n[DONE] {run_id}",
                        flush=True,
                    )

                else:
                    row["status"] = "failed"
                    row["last_error"] = (
                        f"exit_code={code}"
                    )
                    failed_session += 1

                    print(
                        f"\n[FAILED] "
                        f"{run_id} "
                        f"exit={code}",
                        flush=True,
                    )

                save_plan(
                    args.plan,
                    rows,
                    fields,
                )

                del running[
                    run_id
                ]

            #
            # Is everything finished?
            #
            unfinished = [
                r
                for r in rows
                if r["run_id"] in allowed_ids
                and r["status"]
                not in {
                    "completed",
                    "failed",
                }
            ]

            if (
                not unfinished
                and not running
            ):
                break

            #
            # Calculate GPU admission.
            #
            # Fixed mode retains the original scheduler behavior.
            # Adaptive mode instead observes the whole GPU, including
            # external processes, and admits at most one new job per
            # control cycle.
            #
            gpu = gpu_status(
                args.gpu
            )

            host = host_memory_status()
            host_available_gib = host["available"]

            free_gib = (
                gpu["free"] / 1024
            )

            used_gib = (
                gpu["used"] / 1024
            )

            util_now = float(
                gpu["util"]
            )

            # ------------------------------------------------
            # Emergency memory guard.
            #
            # This never touches Qwen or any external process:
            # only entries in our own `running` dictionary.
            # ------------------------------------------------
            critical_now = (
                free_gib <= args.critical_free_gib
                or used_gib >= args.critical_used_gib
                or host_available_gib
                    <= args.critical_host_available_gib
            )

            if critical_now:
                critical_count += 1
            else:
                critical_count = 0

            if (
                args.adaptive_gpu
                and critical_count >= args.critical_samples
                and running
                and time.time() >= shed_cooldown_until
            ):
                # Newest scheduler-owned job = least work lost.
                victim_id, victim = max(
                    running.items(),
                    key=lambda kv: kv[1].get(
                        "launched_at",
                        0.0,
                    ),
                )

                print(
                    f"\\n[SHED] critical GPU pressure: "
                    f"used={used_gib:.2f}GiB "
                    f"free={free_gib:.2f}GiB. "
                    f"Stopping newest job {victim_id}",
                    flush=True,
                )

                stop_process(
                    victim["process"]
                )

                victim_row = by_id[victim_id]

                victim_row["status"] = "planned"
                victim_row["started_at"] = ""
                victim_row["finished_at"] = ""
                victim_row["exit_code"] = ""
                victim_row["last_error"] = (
                    "Adaptive GPU shed; returned to queue"
                )

                del running[victim_id]

                save_plan(
                    args.plan,
                    rows,
                    fields,
                )

                critical_count = 0

                shed_cooldown_until = (
                    time.time()
                    + args.shed_cooldown_seconds
                )

                adaptive_probe = None

                # Re-measure on next control iteration.
                time.sleep(
                    min(
                        args.poll_seconds,
                        5,
                    )
                )
                continue

            if adaptive_util_ema is None:
                adaptive_util_ema = util_now
            else:
                adaptive_util_ema = (
                    0.25 * util_now
                    + 0.75 * adaptive_util_ema
                )

            # Learn the approximate incremental memory cost of a job
            # after giving the newly launched process time to allocate
            # its steady-state tensors.
            if (
                args.adaptive_gpu
                and adaptive_probe is not None
                and time.time()
                    - adaptive_probe["time"]
                    >= args.adaptive_warmup_seconds
            ):
                observed = max(
                    0.0,
                    used_gib
                    - adaptive_probe["used_before"],
                )

                # Ignore tiny/noisy negative/external-process deltas.
                if observed >= 0.25:
                    if adaptive_job_mem_ewma is None:
                        adaptive_job_mem_ewma = observed
                    else:
                        a = args.adaptive_ewma_alpha
                        adaptive_job_mem_ewma = (
                            a * observed
                            + (1.0 - a)
                            * adaptive_job_mem_ewma
                        )

                adaptive_probe = None

            if args.adaptive_gpu:
                parallel_cap = (
                    args.hard_max_parallel
                )

                predicted_job_gib = max(
                    args.adaptive_min_job_gib,
                    adaptive_job_mem_ewma
                    if adaptive_job_mem_ewma is not None
                    else args.reserve_per_job_gib,
                )

                warmup_active = (
                    adaptive_probe is not None
                    and time.time()
                        - adaptive_probe["time"]
                        < args.adaptive_warmup_seconds
                )

                enough_parallel = (
                    len(running)
                    < parallel_cap
                )

                # Soft targets tell us when the card is already full
                # enough for throughput. Hard VRAM prevents admitting
                # a job whose estimated footprint would cross the
                # safety boundary.
                below_soft_mem = (
                    used_gib
                    < args.target_vram_gib
                )

                below_soft_util = (
                    adaptive_util_ema
                    < args.target_util
                )

                below_hard_prediction = (
                    used_gib
                    + predicted_job_gib
                    <= args.hard_vram_gib
                )

                # Also retain a small absolute amount of free memory.
                enough_free = (
                    free_gib
                    >= max(
                        1.0,
                        predicted_job_gib,
                    )
                )

                host_can_admit = (
                    host_available_gib
                    >= max(
                        args.target_host_available_gib,
                        args.reserve_host_per_job_gib,
                    )
                )

                can_admit = (
                    enough_parallel
                    and not warmup_active
                    and below_hard_prediction
                    and enough_free
                    and below_soft_mem
                    and below_soft_util
                    and host_can_admit
                    and time.time() >= shed_cooldown_until
                )

                slots = (
                    1
                    if can_admit
                    else 0
                )

                reasons = []

                if not host_can_admit:
                    reasons.append("host-ram")

                if warmup_active:
                    reasons.append("warmup")

                if not enough_parallel:
                    reasons.append("parallel-cap")

                if not below_hard_prediction:
                    reasons.append("hard-vram")

                if not enough_free:
                    reasons.append("free-vram")

                if (
                    not below_soft_mem
                    and not below_soft_util
                ):
                    reasons.append("soft-target")

                adaptive_reason = (
                    "ADMIT"
                    if can_admit
                    else ",".join(reasons)
                    if reasons
                    else "HOLD"
                )

            else:
                mem_slots = max(
                    0,
                    math.floor(
                        (
                            free_gib
                            - args.headroom_gib
                        )
                        / args.reserve_per_job_gib
                    ),
                )

                slots = min(
                    args.max_parallel
                    - len(running),
                    mem_slots,
                )

                predicted_job_gib = (
                    args.reserve_per_job_gib
                )

                adaptive_reason = "fixed"

            #
            # Determine jobs whose dependencies
            # have just become available.
            #
            ready_rows = [
                r
                for r in rows
                if r["run_id"] in allowed_ids
                and ready(
                    r,
                    by_id,
                )
                and r["run_id"]
                not in running
            ]

            #
            # Prefer evaluation of already-finished
            # checkpoints, then continue training.
            #
            ready_rows.sort(
                key=lambda r: (
                    0
                    if r["job_type"]
                    == "eval"
                    else 1,
                    r["run_id"],
                )
            )

            if (
                ready_rows
                and slots > 0
                and (
                    time.time()
                    - last_launch
                    >= args.launch_gap
                )
            ):
                row = ready_rows[0]

                run_id = row["run_id"]

                out = (
                    args.run_root
                    / run_id
                )

                out.mkdir(
                    parents=True,
                    exist_ok=True,
                )

                if (
                    row["job_type"]
                    == "train"
                ):
                    cmd = build_train(
                        row,
                        args,
                        out,
                    )

                else:
                    cmd = build_eval(
                        row,
                        args,
                        out,
                        by_id,
                    )

                env = os.environ.copy()

                env[
                    "CUDA_VISIBLE_DEVICES"
                ] = str(args.gpu)

                env[
                    "PYTHONUNBUFFERED"
                ] = "1"

                old = env.get(
                    "PYTHONPATH",
                    "",
                )

                env["PYTHONPATH"] = ":".join(
                    x
                    for x in [
                        str(ROOT),
                        args.data_site,
                        old,
                    ]
                    if x
                )

                row["status"] = "running"
                row["started_at"] = now()
                row["finished_at"] = ""
                row["exit_code"] = ""
                row["last_error"] = ""

                row["attempt"] = str(
                    int(
                        row.get(
                            "attempt",
                            "0",
                        )
                        or 0
                    )
                    + 1
                )

                save_plan(
                    args.plan,
                    rows,
                    fields,
                )

                print()
                print(
                    f"[LAUNCH] "
                    f"{run_id}"
                )
                print(
                    f"         "
                    f"type={row['job_type']} "
                    f"backbone={row['backbone']} "
                    f"method={row['method']} "
                    f"seed={row['seed']}"
                )

                process = (
                    subprocess.Popen(
                        cmd,
                        cwd=ROOT,
                        env=env,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        bufsize=1,
                        start_new_session=True,
                    )
                )

                thread = threading.Thread(
                    target=stream,
                    args=(
                        run_id,
                        process,
                        out / "stdout.log",
                    ),
                    daemon=True,
                )

                thread.start()

                if args.adaptive_gpu:
                    adaptive_probe = {
                        "run_id": run_id,
                        "used_before": used_gib,
                        "time": time.time(),
                    }

                running[run_id] = {
                    "process": process,
                    "launched_at": time.time(),
                    "thread": thread,
                    "out": out,
                }

                last_launch = (
                    time.time()
                )

            counts = {}

            for row in rows:
                s = row["status"]
                counts[s] = (
                    counts.get(s, 0)
                    + 1
                )

            print(
                f"\r[STATUS {now()}] "
                f"running={len(running)} | "
                f"planned={counts.get('planned',0)} | "
                f"completed={counts.get('completed',0)}/"
                f"{len(rows)} | "
                f"failed={counts.get('failed',0)} | "
                f"GPU={gpu['used']/1024:.1f}/"
                f"{gpu['total']/1024:.1f}GiB "
                f"util={gpu['util']:.0f}% "
                f"RAMavail={host_available_gib:.1f}/{host['total']:.1f}GiB "
                f"uEMA={adaptive_util_ema:.0f}% "
                f"next≈{predicted_job_gib:.1f}GiB "
                f"admission={adaptive_reason}    ",
                end="",
                flush=True,
            )

            time.sleep(
                args.poll_seconds
            )

    except KeyboardInterrupt:
        print(
            "\n[CTRL+C] stopping jobs",
            flush=True,
        )

        for run_id, info in (
            running.items()
        ):
            stop_process(
                info["process"]
            )

            row = by_id[
                run_id
            ]

            row["status"] = (
                "interrupted"
            )

            row["finished_at"] = (
                now()
            )

            row["last_error"] = (
                "Interrupted by user"
            )

        save_plan(
            args.plan,
            rows,
            fields,
        )

        return 130

    print()
    print("=" * 78)
    print("ALL SCHEDULING FINISHED")
    print(
        "completed:",
        sum(
            r["status"] == "completed"
            for r in rows
        ),
        "/",
        len(rows),
    )
    print(
        "failed   :",
        sum(
            r["status"] == "failed"
            for r in rows
        ),
    )
    print("=" * 78)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
