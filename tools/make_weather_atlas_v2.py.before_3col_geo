def keys_for_lead(
    lead,
):

    return [
        k
        for k, v
        in cases_meta.items()
        if int(
            v["lead"]
        ) == int(lead)
    ]


def representative_key(
    lead,
):
    """
    Strictly representative:
    select the case whose RAW normalized RMSE
    is closest to the median for that lead.

    No repair-gain cherry picking.
    """

    keys = keys_for_lead(
        lead
    )

    vals = np.asarray([
        scores[k][
            "raw_nrmse"
        ]
        for k in keys
    ])

    med = np.median(vals)

    idx = np.argmin(
        np.abs(
            vals - med
        )
    )

    return keys[int(idx)]


def strong_phys_key(
    lead,
):
    """
    Supplementary illustrative case:
    among middle-to-high raw difficulty cases,
    select strongest Phys improvement.
    """

    keys = keys_for_lead(
        lead
    )

    raw = np.asarray([
        scores[k][
            "raw_nrmse"
        ]
        for k in keys
    ])

    phys = np.asarray([
        scores[k][
            "phys_nrmse"
        ]
        for k in keys
    ])

    lo = np.quantile(
        raw,
        0.50,
    )

    hi = np.quantile(
        raw,
        0.90,
    )

    mask = (
        (raw >= lo)
        & (raw <= hi)
    )

    gain = raw - phys

    gain[
        ~mask
    ] = -np.inf

    return keys[
        int(
            np.argmax(
                gain
            )
        )
    ]


