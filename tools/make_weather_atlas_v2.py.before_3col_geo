def make_synoptic_atlas(
    key,
    stem,
    subtitle,
):

    channel_info = meta[
        "channel_info"
    ]

    vars_present = [
        k
        for k in [
            "z500",
            "t850",
            "q700",
            "wind850",
        ]
        if k in channel_info
    ]

    nrows = len(
        vars_present
    )

    cols = [
        "ERA5 target",
        "Raw ClimaX",
        "ConserveFM-Acc",
        "ConserveFM-Phys",
        "Acc error reduction",
        "Phys error reduction",
    ]

    fig = plt.figure(
        figsize=(
            28,
            4.45 * nrows,
        )
    )

    gs = fig.add_gridspec(
        nrows,
        6,
        wspace=0.055,
        hspace=0.18,
    )

    for ri, var in enumerate(
        vars_present
    ):

        info = channel_info[
            var
        ]

        target = case_array(
            key,
            "target",
            var,
        )

        raw = case_array(
            key,
            "raw",
            var,
        )

        acc = case_array(
            key,
            "acc",
            var,
        )

        phys = case_array(
            key,
            "phys",
            var,
        )

        main_fields = [
            target,
            raw,
            acc,
            phys,
        ]

        vmin, vmax = robust_limits(
            main_fields,
            1,
            99,
        )

        acc_gain = (
            np.abs(
                raw - target
            )
            - np.abs(
                acc - target
            )
        )

        phys_gain = (
            np.abs(
                raw - target
            )
            - np.abs(
                phys - target
            )
        )

        gain_lim = symmetric_limit(
            [
                acc_gain,
                phys_gain,
            ],
            98,
        )

        gain_norm = TwoSlopeNorm(
            vmin=-gain_lim,
            vcenter=0,
            vmax=gain_lim,
        )

        row_fields = [
            target,
            raw,
            acc,
            phys,
            acc_gain,
            phys_gain,
        ]

        last_main = None
        last_gain = None

        for ci, field in enumerate(
            row_fields
        ):

            ax = new_map_ax(
                fig,
                gs[
                    ri,
                    ci,
                ],
            )

            if ci < 4:

                im = plot_geo(
                    ax,
                    field,
                    info[
                        "cmap"
                    ],
                    vmin=vmin,
                    vmax=vmax,
                )

                last_main = im

                # Z500 contour overlay.
                if var == "z500":

                    ff, lat, lon = (
                        geo_prepare(
                            field,
                            LAT,
                            LON,
                        )
                    )

                    levels = np.arange(
                        math.floor(
                            np.nanmin(
                                ff
                            ) / 6
                        ) * 6,
                        math.ceil(
                            np.nanmax(
                                ff
                            ) / 6
                        ) * 6 + 6,
                        6,
                    )

                    try:
                        if HAVE_CARTOPY:
                            ax.contour(
                                lon,
                                lat,
                                ff,
                                levels=levels,
                                colors=BLACK,
                                linewidths=0.35,
                                alpha=0.42,
                                transform=ccrs.PlateCarree(),
                            )
                        else:
                            ax.contour(
                                lon,
                                lat,
                                ff,
                                levels=levels,
                                colors=BLACK,
                                linewidths=0.35,
                                alpha=0.42,
                            )
                    except Exception:
                        pass

            else:

                im = plot_geo(
                    ax,
                    field,
                    "RdBu",
                    norm=gain_norm,
                )

                last_gain = im

            if ri == 0:

                ax.set_title(
                    cols[ci],
                    fontsize=21,
                    fontweight="bold",
                    pad=10,
                    bbox=dict(
                        facecolor=WHITE,
                        edgecolor=RED,
                        linewidth=1.0,
                        boxstyle="round,pad=0.26",
                    ),
                )

            if ci == 0:

                ax.text(
                    -0.07,
                    0.5,
                    (
                        f"{info['label']}\n"
                        f"[{info['unit']}]"
                    ),
                    transform=ax.transAxes,
                    rotation=90,
                    ha="right",
                    va="center",
                    fontsize=19,
                    fontweight="bold",
                )

        # Main-state colorbar.
        cax1 = fig.add_axes([
            0.075,
            0.045
            + (
                nrows - ri - 1
            )
            * (
                0.88
                / nrows
            ),
            0.50,
            0.010,
        ])

        cb1 = fig.colorbar(
            last_main,
            cax=cax1,
            orientation="horizontal",
        )

        cb1.ax.tick_params(
            labelsize=12
        )

        # Error-reduction colorbar.
        cax2 = fig.add_axes([
            0.682,
            0.045
            + (
                nrows - ri - 1
            )
            * (
                0.88
                / nrows
            ),
            0.235,
            0.010,
        ])

        cb2 = fig.colorbar(
            last_gain,
            cax=cax2,
            orientation="horizontal",
        )

        cb2.ax.tick_params(
            labelsize=12
        )

    cm = cases_meta[
        key
    ]

    fig.suptitle(
        (
            f"Synoptic weather-repair atlas · +{cm['lead']} h\n"
            f"{cm['time']} · {subtitle}"
        ),
        fontsize=27,
        fontweight="bold",
        y=0.995,
    )

    fig.text(
        0.5,
        0.006,
        (
            "Error reduction = |Raw − ERA5| − |Repair − ERA5|.  "
            "Blue = repair improves the local forecast; red = repair worsens it."
        ),
        ha="center",
        fontsize=16,
        bbox=dict(
            facecolor=WHITE,
            edgecolor=RED,
            linewidth=1.0,
            boxstyle="round,pad=0.28",
        ),
    )

    savefig(
        fig,
        stem,
    )


