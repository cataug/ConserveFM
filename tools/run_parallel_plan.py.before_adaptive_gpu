#!/usr/bin/env python3

from __future__ import annotations

import argparse
import csv
import math
import os
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path


ROOT = Path.home() / "ConserveFM"

PLAN = ROOT / "manifests/experiments_v1/planned_runs.csv"
RUN_ROOT = ROOT / "runs"

TRAIN_ENTRY = ROOT / "tools/train_conservefm.py"
EVAL_ENTRY = ROOT / "tools/eval_conservefm.py"

RESEARCH = ROOT / "manifests/research_v1"
PRITHVI_RESEARCH = ROOT / "manifests/research_prithvi_transfer_v1"
ERA5 = ROOT / "data/ERA5_WeatherBench2_1979_2022"
FORECAST_ROOT = ROOT / "forecasts"
STATS = RESEARCH / "era5_channel_stats.npz"


MANAGED = [
    "status",
    "result_path",
    "started_at",
    "finished_at",
    "exit_code",
    "attempt",
    "last_error",
]



def research_for_backbone(backbone):
    """Return the research manifest directory for this backbone."""
    if str(backbone).strip().lower() == "prithvi_wxc":
        return PRITHVI_RESEARCH
    return RESEARCH

def now():
    return datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )


def parse_args():
    p = argparse.ArgumentParser()

    p.add_argument("--plan", type=Path, default=PLAN)
    p.add_argument("--run-root", type=Path, default=RUN_ROOT)

    p.add_argument("--python", required=True)
    p.add_argument("--data-site", required=True)

    p.add_argument("--gpu", default="0")

    p.add_argument(
        "--max-parallel",
        type=int,
        default=4,
    )

    p.add_argument(
        "--reserve-per-job-gib",
        type=float,
        default=7.0,
    )

    p.add_argument(
        "--headroom-gib",
        type=float,
        default=4.0,
    )

    p.add_argument(
        "--poll-seconds",
        type=int,
        default=10,
    )

    p.add_argument(
        "--launch-gap",
        type=int,
        default=10,
    )

    p.add_argument(
        "--retry-failed",
        action="store_true",
    )

    p.add_argument(
        "--smoke",
        action="store_true",
    )

    p.add_argument(
        "--limit",
        type=int,
        default=0,
    )

    return p.parse_args()


def load_plan(path):
    with path.open(
        newline="",
        encoding="utf-8",
    ) as f:
        reader = csv.DictReader(f)
        rows = list(reader)
        fields = list(reader.fieldnames or [])

    for field in MANAGED:
        if field not in fields:
            fields.append(field)

    for row in rows:
        for field in MANAGED:
            row.setdefault(field, "")

        if not row["status"]:
            row["status"] = "planned"

        if not row["attempt"]:
            row["attempt"] = "0"

    return rows, fields


def save_plan(path, rows, fields):
    tmp = path.with_suffix(
        path.suffix + ".tmp"
    )

    with tmp.open(
        "w",
        newline="",
        encoding="utf-8",
    ) as f:
        w = csv.DictWriter(
            f,
            fieldnames=fields,
            extrasaction="ignore",
        )

        w.writeheader()
        w.writerows(rows)

        f.flush()
        os.fsync(f.fileno())

    os.replace(tmp, path)


def gpu_status(gpu):
    out = subprocess.check_output(
        [
            "nvidia-smi",
            "-i",
            str(gpu),
            "--query-gpu="
            "memory.total,memory.used,"
            "memory.free,utilization.gpu",
            "--format=csv,noheader,nounits",
        ],
        text=True,
    ).strip()

    total, used, free, util = [
        float(x.strip())
        for x in out.split(",")
    ]

    return {
        "total": total,
        "used": used,
        "free": free,
        "util": util,
    }


def pipe_values(value):
    return ",".join(
        x.strip()
        for x in (value or "").split("|")
        if x.strip()
    )


def ready(row, by_id):
    if row["status"] not in {
        "planned",
        "pending",
        "interrupted",
    }:
        return False

    dep = (
        row.get("depends_on", "")
        or ""
    ).strip()

    if not dep:
        return True

    parent = by_id.get(dep)

    if parent is None:
        return False

    if parent["status"] != "completed":
        return False

    result = (
        parent.get("result_path", "")
        or ""
    )

    if not result:
        return False

    checkpoint = (
        Path(result)
        / "checkpoint_best.pt"
    )

    return checkpoint.exists()


def build_train(row, args, out):
    cmd = [
        args.python,
        "-u",
        str(TRAIN_ENTRY),

        "--run-id",
        row["run_id"],

        "--backbone",
        row["backbone"],

        "--family",
        row["family"],

        "--method",
        row["method"],

        "--seed",
        str(row["seed"]),

        "--research-manifest",
        str(research_for_backbone(row["backbone"])),

        "--era5-zarr",
        str(ERA5),

        "--forecast-root",
        str(FORECAST_ROOT),

        "--stats-path",
        str(STATS),

        "--output-dir",
        str(out),
    ]

    if args.smoke:
        cmd += [
            "--smoke",
            "--max-train-examples", "2",
            "--max-val-examples", "1",
            "--stats-samples", "1",
            "--width", "8",
            "--depth", "1",
        ]

    return cmd


def build_eval(row, args, out, by_id):
    cmd = [
        args.python,
        "-u",
        str(EVAL_ENTRY),

        "--run-id",
        row["run_id"],

        "--backbone",
        row["backbone"],

        "--family",
        row["family"],

        "--method",
        row["method"],

        "--seed",
        str(row["seed"]),

        "--research-manifest",
        str(research_for_backbone(row["backbone"])),

        "--era5-zarr",
        str(ERA5),

        "--forecast-root",
        str(FORECAST_ROOT),

        "--stats-path",
        str(STATS),

        "--output-dir",
        str(out),

        "--lead-hours",
        pipe_values(
            row.get("lead_hours", "")
        ),

        "--stress-types",
        pipe_values(
            row.get("stress_types", "")
        ),

        "--severities",
        pipe_values(
            row.get("severity", "")
        ),
    ]

    if (
        row.get("eval_clean", "")
        .lower() == "true"
    ):
        cmd.append("--eval-clean")

    if (
        row.get("eval_stress", "")
        .lower() == "true"
    ):
        cmd.append("--eval-stress")

    if (
        row.get("eval_ghcn", "")
        .lower() == "true"
    ):
        cmd.append("--eval-ghcn")

    dep = (
        row.get("depends_on", "")
        or ""
    ).strip()

    if dep:
        cmd += [
            "--checkpoint-dir",
            by_id[dep]["result_path"],
        ]

    if args.smoke:
        cmd += [
            "--smoke",
            "--max-clean-examples", "2",
            "--stress-examples", "1",
        ]

    return cmd


def stream(run_id, process, path):
    assert process.stdout is not None

    with path.open(
        "a",
        encoding="utf-8",
    ) as log:

        for line in process.stdout:
            log.write(line)
            log.flush()

            print(
                f"[{run_id}] {line}",
                end="",
                flush=True,
            )


def stop_process(process):
    if process.poll() is not None:
        return

    try:
        os.killpg(
            process.pid,
            signal.SIGTERM,
        )
    except ProcessLookupError:
        return

    try:
        process.wait(timeout=30)
        return

    except subprocess.TimeoutExpired:
        pass

    try:
        os.killpg(
            process.pid,
            signal.SIGKILL,
        )
    except ProcessLookupError:
        pass


def main():
    args = parse_args()

    args.plan = args.plan.expanduser().resolve()
    args.run_root = (
        args.run_root.expanduser().resolve()
    )

    args.run_root.mkdir(
        parents=True,
        exist_ok=True,
    )

    if not STATS.exists():
        raise FileNotFoundError(
            f"Missing stats: {STATS}"
        )

    rows, fields = load_plan(
        args.plan
    )

    #
    # Recover stale processes.
    #
    for row in rows:
        if row["status"] == "running":
            row["status"] = "interrupted"
            row["last_error"] = (
                "Recovered stale running state"
            )

        if (
            row["status"] == "failed"
            and args.retry_failed
        ):
            row["status"] = "planned"

    save_plan(
        args.plan,
        rows,
        fields,
    )

    by_id = {
        r["run_id"]: r
        for r in rows
    }

    #
    # Full mode must have actual forecasts.
    #
    if not args.smoke:
        required = {
            r["backbone"]
            for r in rows
        }

        missing = []

        for backbone in sorted(required):
            path = (
                FORECAST_ROOT
                / f"{backbone}.zarr"
            )

            if not path.exists():
                missing.append(path)

        if missing:
            print(
                "FULL RUN BLOCKED."
            )
            print(
                "Missing forecast stores:"
            )

            for p in missing:
                print(" ", p)

            return 2

    total_planned = len(rows)

    if args.limit > 0:
        allowed_ids = {
            r["run_id"]
            for r in rows[
                :args.limit
            ]
        }
    else:
        allowed_ids = {
            r["run_id"]
            for r in rows
        }

    running = {}

    done_session = 0
    failed_session = 0

    last_launch = 0.0

    print("=" * 78)
    print(
        "ConserveFM unified parallel scheduler"
    )
    print("=" * 78)
    print(
        "plan rows       :",
        total_planned,
    )
    print(
        "train rows      :",
        sum(
            r["job_type"] == "train"
            for r in rows
        ),
    )
    print(
        "eval rows       :",
        sum(
            r["job_type"] == "eval"
            for r in rows
        ),
    )
    print(
        "max parallel    :",
        args.max_parallel,
    )
    print(
        "GPU             :",
        args.gpu,
    )
    print(
        "smoke           :",
        args.smoke,
    )
    print("=" * 78)

    try:
        while True:
            #
            # Collect finished jobs.
            #
            for run_id in list(
                running
            ):
                info = running[
                    run_id
                ]

                code = (
                    info["process"]
                    .poll()
                )

                if code is None:
                    continue

                info["thread"].join(
                    timeout=5
                )

                row = by_id[run_id]

                row["finished_at"] = now()
                row["exit_code"] = str(code)
                row["result_path"] = str(
                    info["out"]
                )

                result_json = (
                    info["out"]
                    / "result.json"
                )

                if (
                    code == 0
                    and result_json.exists()
                ):
                    row["status"] = (
                        "completed"
                    )
                    row["last_error"] = ""
                    done_session += 1

                    print(
                        f"\n[DONE] {run_id}",
                        flush=True,
                    )

                else:
                    row["status"] = "failed"
                    row["last_error"] = (
                        f"exit_code={code}"
                    )
                    failed_session += 1

                    print(
                        f"\n[FAILED] "
                        f"{run_id} "
                        f"exit={code}",
                        flush=True,
                    )

                save_plan(
                    args.plan,
                    rows,
                    fields,
                )

                del running[
                    run_id
                ]

            #
            # Is everything finished?
            #
            unfinished = [
                r
                for r in rows
                if r["run_id"] in allowed_ids
                and r["status"]
                not in {
                    "completed",
                    "failed",
                }
            ]

            if (
                not unfinished
                and not running
            ):
                break

            #
            # Calculate GPU slots.
            #
            gpu = gpu_status(
                args.gpu
            )

            free_gib = (
                gpu["free"] / 1024
            )

            mem_slots = max(
                0,
                math.floor(
                    (
                        free_gib
                        - args.headroom_gib
                    )
                    / args.reserve_per_job_gib
                ),
            )

            slots = min(
                args.max_parallel
                - len(running),
                mem_slots,
            )

            #
            # Determine jobs whose dependencies
            # have just become available.
            #
            ready_rows = [
                r
                for r in rows
                if r["run_id"] in allowed_ids
                and ready(
                    r,
                    by_id,
                )
                and r["run_id"]
                not in running
            ]

            #
            # Prefer evaluation of already-finished
            # checkpoints, then continue training.
            #
            ready_rows.sort(
                key=lambda r: (
                    0
                    if r["job_type"]
                    == "eval"
                    else 1,
                    r["run_id"],
                )
            )

            if (
                ready_rows
                and slots > 0
                and (
                    time.time()
                    - last_launch
                    >= args.launch_gap
                )
            ):
                row = ready_rows[0]

                run_id = row["run_id"]

                out = (
                    args.run_root
                    / run_id
                )

                out.mkdir(
                    parents=True,
                    exist_ok=True,
                )

                if (
                    row["job_type"]
                    == "train"
                ):
                    cmd = build_train(
                        row,
                        args,
                        out,
                    )

                else:
                    cmd = build_eval(
                        row,
                        args,
                        out,
                        by_id,
                    )

                env = os.environ.copy()

                env[
                    "CUDA_VISIBLE_DEVICES"
                ] = str(args.gpu)

                env[
                    "PYTHONUNBUFFERED"
                ] = "1"

                old = env.get(
                    "PYTHONPATH",
                    "",
                )

                env["PYTHONPATH"] = ":".join(
                    x
                    for x in [
                        str(ROOT),
                        args.data_site,
                        old,
                    ]
                    if x
                )

                row["status"] = "running"
                row["started_at"] = now()
                row["finished_at"] = ""
                row["exit_code"] = ""
                row["last_error"] = ""

                row["attempt"] = str(
                    int(
                        row.get(
                            "attempt",
                            "0",
                        )
                        or 0
                    )
                    + 1
                )

                save_plan(
                    args.plan,
                    rows,
                    fields,
                )

                print()
                print(
                    f"[LAUNCH] "
                    f"{run_id}"
                )
                print(
                    f"         "
                    f"type={row['job_type']} "
                    f"backbone={row['backbone']} "
                    f"method={row['method']} "
                    f"seed={row['seed']}"
                )

                process = (
                    subprocess.Popen(
                        cmd,
                        cwd=ROOT,
                        env=env,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        bufsize=1,
                        start_new_session=True,
                    )
                )

                thread = threading.Thread(
                    target=stream,
                    args=(
                        run_id,
                        process,
                        out / "stdout.log",
                    ),
                    daemon=True,
                )

                thread.start()

                running[run_id] = {
                    "process": process,
                    "thread": thread,
                    "out": out,
                }

                last_launch = (
                    time.time()
                )

            counts = {}

            for row in rows:
                s = row["status"]
                counts[s] = (
                    counts.get(s, 0)
                    + 1
                )

            print(
                f"\r[STATUS {now()}] "
                f"running={len(running)} | "
                f"planned={counts.get('planned',0)} | "
                f"completed={counts.get('completed',0)}/"
                f"{len(rows)} | "
                f"failed={counts.get('failed',0)} | "
                f"GPU={gpu['used']/1024:.1f}/"
                f"{gpu['total']/1024:.1f}GiB "
                f"util={gpu['util']:.0f}%    ",
                end="",
                flush=True,
            )

            time.sleep(
                args.poll_seconds
            )

    except KeyboardInterrupt:
        print(
            "\n[CTRL+C] stopping jobs",
            flush=True,
        )

        for run_id, info in (
            running.items()
        ):
            stop_process(
                info["process"]
            )

            row = by_id[
                run_id
            ]

            row["status"] = (
                "interrupted"
            )

            row["finished_at"] = (
                now()
            )

            row["last_error"] = (
                "Interrupted by user"
            )

        save_plan(
            args.plan,
            rows,
            fields,
        )

        return 130

    print()
    print("=" * 78)
    print("ALL SCHEDULING FINISHED")
    print(
        "completed:",
        sum(
            r["status"] == "completed"
            for r in rows
        ),
        "/",
        len(rows),
    )
    print(
        "failed   :",
        sum(
            r["status"] == "failed"
            for r in rows
        ),
    )
    print("=" * 78)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
