from __future__ import annotations

from typing import Dict

import torch
import torch.nn.functional as F

from .channels import ChannelLayout
from .data import Normalizer
from .model import RepairOutput
from .physics import compute_physics_losses
from .registry import MethodConfig


def compute_objective(
    output: RepairOutput,
    target_norm: torch.Tensor,
    previous_phys: torch.Tensor,
    lead_hours: torch.Tensor,
    cfg: MethodConfig,
    layout: ChannelLayout,
    normalizer: Normalizer,
    corruption_mask: torch.Tensor | None = None,
    corruption_type: torch.Tensor | None = None,
    latitude_deg: torch.Tensor | None = None,
):
    losses: Dict[str, torch.Tensor] = {}
    losses["repair"] = F.mse_loss(output.state_norm, target_norm)

    if output.localization_logits is not None and corruption_mask is not None:
        losses["localization"] = F.binary_cross_entropy_with_logits(
            output.localization_logits, corruption_mask
        )
    else:
        losses["localization"] = output.state_norm.new_zeros(())

    if output.type_logits is not None and corruption_type is not None:
        losses["type"] = F.cross_entropy(output.type_logits, corruption_type)
    else:
        losses["type"] = output.state_norm.new_zeros(())

    if cfg.minimal_change:
        losses["minimal"] = output.delta_norm.abs().mean()
    else:
        losses["minimal"] = output.state_norm.new_zeros(())

    physics_losses: Dict[str, torch.Tensor] = {}
    physics_total = output.state_norm.new_zeros(())
    if cfg.use_physics_losses and cfg.enabled_constraints:
        pred_phys = normalizer.denormalize_torch(output.state_norm)
        physics_losses = compute_physics_losses(
            pred_phys,
            previous_phys,
            layout,
            lead_hours,
            cfg.enabled_constraints,
            latitude_deg=latitude_deg,
        )
        for j, name in enumerate(cfg.enabled_constraints):
            weight = output.router_weights[:, j].mean()
            physics_total = physics_total + weight * physics_losses[name]

    losses.update({f"physics_{k}": v for k, v in physics_losses.items()})
    losses["physics"] = physics_total

    total = (
        cfg.lambda_repair * losses["repair"]
        + cfg.lambda_physics * losses["physics"]
        + cfg.lambda_localization * losses["localization"]
        + cfg.lambda_type * losses["type"]
        + cfg.lambda_minimal * losses["minimal"]
    )
    losses["total"] = total
    return total, losses
